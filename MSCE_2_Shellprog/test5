#!/usr/bin/env bash
# 主调试脚本
stdout_file="stdout.txt"
stderr_file="stderr.txt"
count=0

echo "🚀 开始运行 test4 直到失败..."

# 清空输出文件
> "$stdout_file"
> "$stderr_file"

while bash ./test4 > "$stdout_file" 2> "$stderr_file"; do
    # $? 在这里是上一个命令的退出码（0=成功）
    ((count++))
    echo "✅ 第 $count 次运行成功"
done

# 失败时退出码非0，显示结果
echo "💥 第 $((count + 1)) 次运行失败！"
echo "📊 总共运行: $((count + 1)) 次"
echo "📄 stdout内容:"
cat "$stdout_file"
echo "📄 stderr内容:"
cat "$stderr_file"
